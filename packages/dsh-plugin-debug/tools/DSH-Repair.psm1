  'Get-DshRepairProperty',
  'Protect-DshRepairText',
  'New-DshRepairPlan',
  'Test-DshRepairPlan',
  'Read-DshRepairPlan',
  'Write-DshRepairPlan',
  'Invoke-DshRepairPlan',
  'Restore-DshRepairReceipt',
  'New-DshRepairPrompt',
  'Invoke-DshModelRepairAssist'
)
