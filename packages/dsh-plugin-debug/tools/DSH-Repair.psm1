Set-StrictMode -Version Latest

$script:RepairSchemaVersion = 2
$script:RepairMaxOperations = 16
$script:RepairMaxIncidentIdLength = 160
$script:RepairMaxEvidenceLength = 1200
$script:RepairMaxRationaleLength = 1200

Import-Module (Join-Path $PSScriptRoot 'DSH-Guard.psm1') -Force

function Get-DshRepairProperty {
  param(
    [AllowNull()]$Object,
    [Parameter(Mandatory = $true)][string]$Name
  )
  if ($null -eq $Object) { return $null }
  if ($Object -is [System.Collections.IDictionary] -and $Object.Contains($Name)) {
    return $Object[$Name]
  }
  $property = $Object.PSObject.Properties[$Name]
  if ($null -eq $property) { return $null }
  return $property.Value
}

function Get-DshRepairPropertyNames {
  param([AllowNull()]$Object)
  if ($null -eq $Object) { return @() }
  if ($Object -is [System.Collections.IDictionary]) { return @($Object.Keys | ForEach-Object { [string]$_ }) }
  return @($Object.PSObject.Properties | ForEach-Object { [string]$_.Name })
}

function Find-DshRepairForbiddenProperty {
  param(
    [AllowNull()]$Object,
    [Parameter(Mandatory = $true)][string[]]$Forbidden,
    [string]$Path = 'plan',
    [int]$Depth = 0
  )
  if ($null -eq $Object -or $Object -is [string] -or $Object -is [ValueType]) { return }
  # Plans come from bounded JSON, but retain a depth ceiling for callers that
  # invoke Test-DshRepairPlan with an in-memory object instead of JSON.
  if ($Depth -ge 24) {
    Write-Output "$Path exceeds the maximum nested plan depth"
    return
  }
  if ($Object -is [System.Collections.IEnumerable] -and $Object -isnot [System.Collections.IDictionary]) {
    $index = 0
    foreach ($item in $Object) {
      Find-DshRepairForbiddenProperty -Object $item -Forbidden $Forbidden -Path "$Path[$index]" -Depth ($Depth + 1)
      $index += 1
    }
    return
  }
  foreach ($property in Get-DshRepairPropertyNames -Object $Object) {
    $propertyPath = "$Path.$property"
    if ($property -in $Forbidden) {
      Write-Output $propertyPath
      continue
    }
    Find-DshRepairForbiddenProperty -Object (Get-DshRepairProperty -Object $Object -Name $property) -Forbidden $Forbidden -Path $propertyPath -Depth ($Depth + 1)
  }
}

function Resolve-DshRepairPath {
  param(
    [AllowNull()][string]$Path,
    [Parameter(Mandatory = $true)][string]$Fallback
  )
  $candidate = if ([string]::IsNullOrWhiteSpace($Path)) { $Fallback } else { $Path }
  return [IO.Path]::GetFullPath($candidate)
}

function Test-DshRepairPathWithin {
  param(
    [Parameter(Mandatory = $true)][string]$BasePath,
    [Parameter(Mandatory = $true)][string]$CandidatePath
  )
  $base = [IO.Path]::GetFullPath($BasePath).TrimEnd('\') + '\'
  $candidate = [IO.Path]::GetFullPath($CandidatePath)
  return $candidate.StartsWith($base, [StringComparison]::OrdinalIgnoreCase)
}

function Get-DshRepairHash {
  param([Parameter(Mandatory = $true)][string]$Path)
  if (-not (Test-Path -LiteralPath $Path -PathType Leaf)) { return $null }
  $sha = [Security.Cryptography.SHA256]::Create()
  try {
    $bytes = [IO.File]::ReadAllBytes($Path)
    return ([BitConverter]::ToString($sha.ComputeHash($bytes))).Replace('-', '').ToLowerInvariant()
  } finally {
    $sha.Dispose()
  }
}

function Test-DshRepairSha256 {
  param([AllowNull()][string]$Hash)
  return -not [string]::IsNullOrWhiteSpace($Hash) -and $Hash -cmatch '^[a-f0-9]{64}$'
}

function Get-DshRepairTextHash {
  param([Parameter(Mandatory = $true)][string]$Text)
  $sha = [Security.Cryptography.SHA256]::Create()
  try {
    return ([BitConverter]::ToString($sha.ComputeHash([Text.Encoding]::UTF8.GetBytes($Text)))).Replace('-', '').ToLowerInvariant()
  } finally {
    $sha.Dispose()
  }
}

function Write-DshRepairAtomicText {
  param(
    [Parameter(Mandatory = $true)][string]$Path,
    [Parameter(Mandatory = $true)][string]$Text
  )
  $resolved = [IO.Path]::GetFullPath($Path)
  $parent = Split-Path -Parent $resolved
  if (-not (Test-Path -LiteralPath $parent -PathType Container)) { New-Item -ItemType Directory -Path $parent -Force | Out-Null }
  $temporary = "$resolved.tmp-$([guid]::NewGuid().ToString('N'))"
  try {
    [IO.File]::WriteAllText($temporary, $Text, [Text.UTF8Encoding]::new($false))
    Move-Item -LiteralPath $temporary -Destination $resolved -Force
  } finally {
    if (Test-Path -LiteralPath $temporary -PathType Leaf) { Remove-Item -LiteralPath $temporary -Force -ErrorAction SilentlyContinue }
  }
}

function ConvertTo-DshRepairPatchText {
  param([object[]]$Entries = @())
  $lines = @(
    '# Generated by dsh-plugin-debug standalone crash guard.'
    '# Remove an entry from guard-state.json and delete this file to re-enable it.'
  )
  $written = 0
  foreach ($entry in @($Entries | Sort-Object entryId -Unique)) {
    $entryId = [string](Get-DshRepairProperty -Object $entry -Name 'entryId')
    if ([string]::IsNullOrWhiteSpace($entryId)) { continue }
    $entryId = $entryId.Replace("'", "''")
    $lines += "- id: '$entryId'"
    $moduleName = [string](Get-DshRepairProperty -Object $entry -Name 'moduleName')
    if (-not [string]::IsNullOrWhiteSpace($moduleName)) {
      $lines += "  name: '$($moduleName.Replace("'", "''"))'"
    }
    $lines += '  disabled: true'
    $written += 1
  }
  if ($written -eq 0) { $lines += '[]' }
  return (($lines -join [Environment]::NewLine) + [Environment]::NewLine)
}

function Test-DshRepairProfileName {
  param([AllowNull()][string]$Profile)
  return -not [string]::IsNullOrWhiteSpace($Profile) -and
    $Profile.Length -le 128 -and
    $Profile -match '^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$'
}

function Get-DshRepairEvidenceBinding {
  param([Parameter(Mandatory = $true)]$Diagnostics)
  $safeJson = $Diagnostics | ConvertTo-Json -Depth 30 -Compress
  $evidenceHash = Get-DshRepairTextHash -Text $safeJson
  $observedIncidentId = [string](Get-DshRepairProperty -Object $Diagnostics -Name 'id')
  $incidentId = if ([string]::IsNullOrWhiteSpace($observedIncidentId)) {
    'derived-' + $evidenceHash.Substring(0, 16)
  } else {
    Protect-DshRepairText -Value $observedIncidentId -MaxLength $script:RepairMaxIncidentIdLength
  }
  $inventory = Get-DshRepairProperty -Object $Diagnostics -Name 'pluginInventory'
  $failedEntries = @(Get-DshRepairProperty -Object $inventory -Name 'failed')
  $candidateIds = @($failedEntries | ForEach-Object {
      [string](Get-DshRepairProperty -Object $_ -Name 'moduleName')
    } | Where-Object { -not [string]::IsNullOrWhiteSpace($_) } | Sort-Object -Unique)
  return [ordered]@{
    incidentId = $incidentId
    evidenceHash = $evidenceHash
    observedCandidateIds = $candidateIds
  }
}

function Protect-DshRepairText {
  param(
    [AllowNull()][string]$Value,
    [int]$MaxLength = 16000
  )
  if ($null -eq $Value) { return $null }
  $result = $Value
  $result = $result -replace '(?i)(api[_-]?key|token|password|secret|authorization)\s*[:=]\s*("[^"]*"|''[^'']*''|[^\s,}]+)', '$1=<redacted>'
  $result = $result -replace '(?i)[A-Z]:\\[^\s;,)}]+', '<path>'
  $result = $result -replace '(?i)https?://[^\s]+', '<url>'
  if ($result.Length -gt $MaxLength) { return $result.Substring(0, $MaxLength) + '...' }
  return $result
}

function Test-DshRepairPluginId {
  param([AllowNull()][string]$PluginId)
  if ([string]::IsNullOrWhiteSpace($PluginId)) { return $false }
  if ($PluginId -match '^(?i:include):') { return $false }
  if ($PluginId.Length -gt 180) { return $false }
  if ($PluginId -notmatch '^[A-Za-z0-9@._+/-]+$') { return $false }
  if ($PluginId -match '^@deepseek-ai/') { return $false }
  if ($PluginId -in @('react', 'react-dom', 'zod', 'dsh-base', 'dsh-web-app')) { return $false }
  return $PluginId -match '(?i)(^|[-/])dsh-plugin([-/.]|$)|(^|[-/])plugin([-/.]|$)'
}

function New-DshRepairPlan {
  param(
    [Parameter(Mandatory = $true)]$Diagnostics,
    [string]$Profile = 'debug',
    [string]$StateRoot = '',
    [string]$Reason = ''
  )
  if (-not (Test-DshRepairProfileName -Profile $Profile)) { throw "invalid repair Profile name: $Profile" }
  $binding = Get-DshRepairEvidenceBinding -Diagnostics $Diagnostics
  $operations = [System.Collections.Generic.List[object]]::new()
  $failedEntries = @(Get-DshRepairProperty -Object (Get-DshRepairProperty -Object $Diagnostics -Name 'pluginInventory') -Name 'failed')
  $quarantineCandidateIds = @{}
  foreach ($entry in $failedEntries) {
    $moduleName = [string](Get-DshRepairProperty -Object $entry -Name 'moduleName')
    if (-not (Test-DshRepairPluginId -PluginId $moduleName)) { continue }
    if ($quarantineCandidateIds.ContainsKey($moduleName)) { continue }
    $quarantineCandidateIds[$moduleName] = $true
    [void]$operations.Add([ordered]@{
        kind = 'quarantine-plugin'
        pluginId = $moduleName
        candidateId = $moduleName
        evidence = 'runtime.pluginInventory.failed'
        confidence = 'observed'
        requiresApproval = $true
        rationale = 'The DSH host inventory reports a failed third-party plugin candidate; quarantine is reversible and applies only to the Profile patch.'
      })
  }

  $toolObservation = Get-DshRepairProperty -Object $Diagnostics -Name 'toolCallObservation'
  $session = Get-DshRepairProperty -Object $toolObservation -Name 'session'
  $stats = Get-DshRepairProperty -Object $session -Name 'toolCallStats'
  if ($null -ne $stats -and [int](Get-DshRepairProperty -Object $stats -Name 'errorResultCount') -gt 0) {
    [void]$operations.Add([ordered]@{
        kind = 'recommendation'
        recommendationCode = 'tool-call-errors-observed'
        message = 'Inspect the bounded Tool Call metadata and the exact failing tool before changing sandbox or approval defaults.'
        mutates = $false
      })
  }

  $permission = Get-DshRepairProperty -Object $Diagnostics -Name 'permission'
  if ([string](Get-DshRepairProperty -Object $permission -Name 'settingsDefaultPreset') -eq 'danger-full-access') {
    [void]$operations.Add([ordered]@{
        kind = 'recommendation'
        recommendationCode = 'permission-default-full-access'
        message = 'Do not silently rewrite permission defaults. Reproduce the Tool Call and use the native approval/sandbox path first.'
        mutates = $false
      })
  }

  if ($quarantineCandidateIds.Count -gt 0) {
    [void]$operations.Add([ordered]@{
        kind = 'restart-profile'
        profile = $Profile
        requiresApproval = $true
        mutates = $false
        rationale = 'A quarantine patch is read on the next DSH start; this plan does not stop or restart a running process automatically.'
      })
  }

  return [ordered]@{
    schemaVersion = $script:RepairSchemaVersion
    incidentId = $binding.incidentId
    evidenceHash = $binding.evidenceHash
    observedCandidateIds = @($binding.observedCandidateIds)
    generatedAt = (Get-Date).ToUniversalTime().ToString('o')
    expiresAt = (Get-Date).ToUniversalTime().AddHours(1).ToString('o')
    profile = $Profile
    mode = 'advisory'
    source = 'dsh-plugin-debug-diagnostics'
    reason = Protect-DshRepairText -Value $Reason -MaxLength 600
    operations = @($operations)
    safety = [ordered]@{
      default = 'dry-run'
      modelMaySuggest = 'Only the allowlisted JSON operations are accepted; arbitrary commands, scripts, paths, URLs, and tool arguments are rejected.'
      automaticChanges = 'none'
      rollback = 'quarantine changes can be reverted from the generated receipt; profile and workspace restore remain explicit user actions.'
    }
  }
}

function Test-DshRepairPlan {
  param([AllowNull()]$Plan)
  $errors = [System.Collections.Generic.List[string]]::new()
  $warnings = [System.Collections.Generic.List[string]]::new()
  if ($null -eq $Plan) {
    [void]$errors.Add('plan is null')
    return [ordered]@{ valid = $false; errors = @($errors); warnings = @($warnings) }
  }
  if ([int](Get-DshRepairProperty -Object $Plan -Name 'schemaVersion') -ne $script:RepairSchemaVersion) {
    [void]$errors.Add("unsupported repair plan schemaVersion: $([string](Get-DshRepairProperty -Object $Plan -Name 'schemaVersion'))")
  }
  $allowedTopLevel = @(
    'schemaVersion', 'incidentId', 'evidenceHash', 'observedCandidateIds',
    'generatedAt', 'expiresAt', 'profile', 'mode', 'source', 'reason',
    'operations', 'safety'
  )
  foreach ($property in Get-DshRepairPropertyNames -Object $Plan) {
    if ($property -notin $allowedTopLevel) { [void]$errors.Add("plan contains unknown property '$property'") }
  }
  $incidentId = [string](Get-DshRepairProperty -Object $Plan -Name 'incidentId')
  if ([string]::IsNullOrWhiteSpace($incidentId) -or $incidentId.Length -gt $script:RepairMaxIncidentIdLength) {
    [void]$errors.Add('plan.incidentId is required and bounded')
  }
  $evidenceHash = [string](Get-DshRepairProperty -Object $Plan -Name 'evidenceHash')
  if ($evidenceHash -notmatch '^[a-f0-9]{64}$') { [void]$errors.Add('plan.evidenceHash must be a lowercase SHA-256') }
  $profile = [string](Get-DshRepairProperty -Object $Plan -Name 'profile')
  if (-not (Test-DshRepairProfileName -Profile $profile)) { [void]$errors.Add('plan.profile is invalid') }
  if ([string](Get-DshRepairProperty -Object $Plan -Name 'mode') -cne 'advisory') { [void]$errors.Add('plan.mode must be advisory') }
  $expiresAt = $null
  try { $expiresAt = [DateTimeOffset]::Parse([string](Get-DshRepairProperty -Object $Plan -Name 'expiresAt')).ToUniversalTime() }
  catch { [void]$errors.Add('plan.expiresAt must be an ISO timestamp') }
  if ($null -ne $expiresAt -and $expiresAt -le [DateTimeOffset]::UtcNow) { [void]$errors.Add('plan has expired') }
  $observedCandidateIds = @(
    Get-DshRepairProperty -Object $Plan -Name 'observedCandidateIds' |
      ForEach-Object { [string]$_ } |
      Where-Object { -not [string]::IsNullOrWhiteSpace($_) } |
      Sort-Object -Unique
  )
  if ($observedCandidateIds.Count -gt 200) { [void]$errors.Add('plan.observedCandidateIds is too large') }
  $operations = @(Get-DshRepairProperty -Object $Plan -Name 'operations')
  if ($operations.Count -gt $script:RepairMaxOperations) {
    [void]$errors.Add("too many operations; maximum is $script:RepairMaxOperations")
  }
  $forbidden = @('command', 'commands', 'script', 'shell', 'args', 'arguments', 'path', 'url', 'cwd', 'expression', 'eval', 'code')
  foreach ($forbiddenPath in @(Find-DshRepairForbiddenProperty -Object $Plan -Forbidden $forbidden)) {
    [void]$errors.Add("plan contains forbidden property '$forbiddenPath'")
  }
  $seenCandidates = @{}
  for ($index = 0; $index -lt $operations.Count; $index++) {
    $operation = $operations[$index]
    $kind = [string](Get-DshRepairProperty -Object $operation -Name 'kind')
    if ($kind -notin @('quarantine-plugin', 'restart-profile', 'recommendation')) {
      [void]$errors.Add("operations[$index].kind is not allowlisted")
      continue
    }
    $allowedOperationProperties = switch ($kind) {
      'quarantine-plugin' { @('kind', 'pluginId', 'candidateId', 'evidence', 'confidence', 'requiresApproval', 'rationale') }
      'restart-profile' { @('kind', 'profile', 'requiresApproval', 'mutates', 'rationale') }
      'recommendation' { @('kind', 'recommendationCode', 'message', 'mutates') }
    }
    foreach ($property in Get-DshRepairPropertyNames -Object $operation) {
      if ($property -notin $allowedOperationProperties) { [void]$errors.Add("operations[$index] contains unknown property '$property'") }
    }
    if ($kind -eq 'quarantine-plugin') {
      $pluginId = [string](Get-DshRepairProperty -Object $operation -Name 'pluginId')
      $candidateId = [string](Get-DshRepairProperty -Object $operation -Name 'candidateId')
      if (-not (Test-DshRepairPluginId -PluginId $pluginId)) {
        [void]$errors.Add("operations[$index].pluginId is not a safe third-party plugin id")
      }
      if ($candidateId -cne $pluginId -or $candidateId -notin $observedCandidateIds) {
        [void]$errors.Add("operations[$index].candidateId is not an observed candidate")
      }
      if ($seenCandidates.ContainsKey($candidateId)) { [void]$errors.Add("operations[$index] duplicates candidate '$candidateId'") }
      if (-not [string]::IsNullOrWhiteSpace($candidateId)) { $seenCandidates[$candidateId] = $true }
      if ([bool](Get-DshRepairProperty -Object $operation -Name 'requiresApproval') -ne $true) {
        [void]$errors.Add("operations[$index].requiresApproval must be true")
      }
      $evidence = [string](Get-DshRepairProperty -Object $operation -Name 'evidence')
      $rationale = [string](Get-DshRepairProperty -Object $operation -Name 'rationale')
      if ([string]::IsNullOrWhiteSpace($evidence) -or $evidence.Length -gt $script:RepairMaxEvidenceLength) { [void]$errors.Add("operations[$index].evidence is required and bounded") }
      if ([string]::IsNullOrWhiteSpace($rationale) -or $rationale.Length -gt $script:RepairMaxRationaleLength) { [void]$errors.Add("operations[$index].rationale is required and bounded") }
      if ([string](Get-DshRepairProperty -Object $operation -Name 'confidence') -notin @('observed', 'review')) { [void]$errors.Add("operations[$index].confidence is invalid") }
    }
    if ($kind -eq 'restart-profile') {
      if ([string](Get-DshRepairProperty -Object $operation -Name 'profile') -cne $profile) { [void]$errors.Add("operations[$index].profile must match plan.profile") }
      if ([bool](Get-DshRepairProperty -Object $operation -Name 'requiresApproval') -ne $true) { [void]$errors.Add("operations[$index].requiresApproval must be true") }
      if ([bool](Get-DshRepairProperty -Object $operation -Name 'mutates') -ne $false) { [void]$errors.Add("operations[$index].mutates must be false") }
      $rationale = [string](Get-DshRepairProperty -Object $operation -Name 'rationale')
      if ([string]::IsNullOrWhiteSpace($rationale) -or $rationale.Length -gt $script:RepairMaxRationaleLength) { [void]$errors.Add("operations[$index].rationale is required and bounded") }
    }
    if ($kind -eq 'recommendation') {
      if ([string]::IsNullOrWhiteSpace([string](Get-DshRepairProperty -Object $operation -Name 'message'))) { [void]$errors.Add("operations[$index].message is required") }
      if ([string](Get-DshRepairProperty -Object $operation -Name 'message').Length -gt $script:RepairMaxRationaleLength) { [void]$errors.Add("operations[$index].message is too long") }
      if ([bool](Get-DshRepairProperty -Object $operation -Name 'mutates') -ne $false) { [void]$errors.Add("operations[$index].mutates must be false") }
    }
  }
  if ($operations.Count -eq 0) { [void]$warnings.Add('plan contains no operations; no repair is indicated by the supplied evidence') }
  return [ordered]@{ valid = $errors.Count -eq 0; errors = @($errors); warnings = @($warnings) }
}

function Read-DshRepairPlan {
  param([Parameter(Mandatory = $true)][string]$Path)
  if (-not (Test-Path -LiteralPath $Path -PathType Leaf)) { throw "repair plan does not exist: $Path" }
  $raw = Get-Content -LiteralPath $Path -Raw -Encoding UTF8
  if ($raw.Length -gt 1048576) { throw 'repair plan is larger than 1 MiB' }
  try { $plan = $raw | ConvertFrom-Json } catch { throw "repair plan is not valid JSON: $($_.Exception.Message)" }
  $check = Test-DshRepairPlan -Plan $plan
  if (-not $check.valid) { throw "repair plan rejected: $($check.errors -join '; ')" }
  return $plan
}

function Write-DshRepairPlan {
  param(
    [Parameter(Mandatory = $true)]$Plan,
    [Parameter(Mandatory = $true)][string]$Path
  )
  $parent = Split-Path -Parent ([IO.Path]::GetFullPath($Path))
  if (-not (Test-Path -LiteralPath $parent -PathType Container)) { New-Item -ItemType Directory -Path $parent -Force | Out-Null }
  $Plan | ConvertTo-Json -Depth 20 | Set-Content -LiteralPath $Path -Encoding UTF8
  return [IO.Path]::GetFullPath($Path)
}

function New-DshRepairReceipt {
  param(
    [Parameter(Mandatory = $true)][string]$StateRoot,
    [Parameter(Mandatory = $true)][string]$Profile
  )
  $resolvedState = [IO.Path]::GetFullPath($StateRoot)
  if ([IO.Path]::GetPathRoot($resolvedState).TrimEnd('\') -eq $resolvedState.TrimEnd('\')) { throw 'refusing to use a filesystem root as repair StateRoot' }
  $repairRoot = Join-Path $resolvedState 'repair'
  $id = (Get-Date).ToUniversalTime().ToString('yyyyMMdd-HHmmss-fff') + '-' + [guid]::NewGuid().ToString('N').Substring(0, 8)
  $receiptRoot = Join-Path $repairRoot $id
  $preimageRoot = Join-Path $receiptRoot 'preimage'
  New-Item -ItemType Directory -Path $preimageRoot -Force | Out-Null
  $files = [System.Collections.Generic.List[object]]::new()
  foreach ($relativePath in @('guard-state.json', 'guard.patch.yml')) {
    $source = Join-Path $resolvedState $relativePath
    $exists = Test-Path -LiteralPath $source -PathType Leaf
    if ($exists) { Copy-Item -LiteralPath $source -Destination (Join-Path $preimageRoot $relativePath) -Force }
    [void]$files.Add([ordered]@{
        relativePath = $relativePath
        existed = $exists
        sha256 = if ($exists) { Get-DshRepairHash -Path $source } else { $null }
        postSha256 = $null
      })
  }
  $manifest = [ordered]@{
    schemaVersion = 2
    id = $id
    profile = $Profile
    stateRoot = $resolvedState
    createdAt = (Get-Date).ToUniversalTime().ToString('o')
    preimageRoot = 'preimage'
    transaction = [ordered]@{ status = 'prepared'; committedAt = $null }
    files = @($files)
    safety = 'Only guard-state.json and guard.patch.yml are eligible for automatic rollback; Profile package manifests and workspace files are never overwritten by this operation.'
  }
  $manifestPath = Join-Path $receiptRoot 'manifest.json'
  Write-DshRepairAtomicText -Path $manifestPath -Text ($manifest | ConvertTo-Json -Depth 12)
  $transactionPath = Join-Path $receiptRoot 'transaction.json'
  $transaction = [ordered]@{
    schemaVersion = 1
    receiptId = $id
    profile = $Profile
    stateRoot = $resolvedState
    status = 'prepared'
    createdAt = $manifest.createdAt
    committedAt = $null
    safety = 'This journal records the two guard-file transaction boundary; it is not a workspace or Profile manifest.'
  }
  Write-DshRepairAtomicText -Path $transactionPath -Text ($transaction | ConvertTo-Json -Depth 12)
  return [PSCustomObject]@{ id = $id; root = $receiptRoot; path = $manifestPath; transactionPath = $transactionPath; manifest = $manifest }
}

function Set-DshRepairPluginQuarantine {
  param(
    [Parameter(Mandatory = $true)][string]$PluginId,
    [Parameter(Mandatory = $true)][string]$Profile,
    [Parameter(Mandatory = $true)][string]$DshHome,
    [Parameter(Mandatory = $true)][string]$StateRoot
  )
  $manifestPath = Join-Path ([IO.Path]::GetFullPath($DshHome)) "profiles\$Profile\package.json"
  $manifest = Read-DshProfileManifest -Path $manifestPath
  if (-not (Test-DshGuardCandidate -ModuleName $PluginId -Manifest $manifest)) {
    throw "plugin is not an eligible direct third-party dependency in Profile '$Profile': $PluginId"
  }
  $resolvedState = [IO.Path]::GetFullPath($StateRoot)
  $statePath = Join-Path $resolvedState 'guard-state.json'
  $patchPath = Join-Path $resolvedState 'guard.patch.yml'
  $state = Read-DshGuardState -Path $statePath -Profile $Profile
  $candidate = [PSCustomObject]@{
    entryId = $PluginId
    inventoryEntryId = $null
    patchEntryId = $PluginId
    moduleName = $PluginId
    mapping = 'exact'
    fiberPhase = 'repair-plan'
    reason = 'model-or-diagnostics-assisted-repair'
    attribution = 'explicit-user-apply'
  }
  Add-DshGuardQuarantine -State $state -Candidate $candidate | Out-Null
  $state.lastRun = [PSCustomObject]@{
    at = (Get-Date).ToUniversalTime().ToString('o')
    source = 'dsh-plugin-debug-repair'
    candidates = @($PluginId)
    changed = $true
  }
  Write-DshRepairAtomicText -Path $statePath -Text ($state | ConvertTo-Json -Depth 12)
  Write-DshRepairAtomicText -Path $patchPath -Text (ConvertTo-DshRepairPatchText -Entries (Get-DshGuardPatchEntries -State $state))
  return [ordered]@{ pluginId = $PluginId; statePath = $statePath; patchPath = $patchPath; changed = $true }
}

function Invoke-DshRepairPlan {
  param(
    [Parameter(Mandatory = $true)]$Plan,
    [Parameter(Mandatory = $true)][string]$Profile,
    [Parameter(Mandatory = $true)][string]$DshHome,
    [Parameter(Mandatory = $true)][string]$StateRoot,
    [switch]$Force
  )
  $check = Test-DshRepairPlan -Plan $Plan
  if (-not $check.valid) { throw "repair plan rejected: $($check.errors -join '; ')" }
  $planProfile = [string](Get-DshRepairProperty -Object $Plan -Name 'profile')
  if ($planProfile -cne $Profile) { throw "repair plan Profile '$planProfile' does not match requested Profile '$Profile'" }
  try {
    $planExpiry = [DateTimeOffset]::Parse([string](Get-DshRepairProperty -Object $Plan -Name 'expiresAt')).ToUniversalTime()
    if ($planExpiry -le [DateTimeOffset]::UtcNow) { throw 'repair plan has expired' }
  } catch {
    if ($_.Exception.Message -eq 'repair plan has expired') { throw }
    throw 'repair plan expiresAt is not a valid ISO timestamp'
  }
  $operations = @(Get-DshRepairProperty -Object $Plan -Name 'operations')
  $mutations = @($operations | Where-Object { [string](Get-DshRepairProperty -Object $_ -Name 'kind') -eq 'quarantine-plugin' })
  if ($mutations.Count -eq 0) {
    return [ordered]@{ status = 'no-op'; applied = @(); skipped = @($operations); receipt = $null; changed = $false; safety = 'No mutating operation was present.' }
  }
  if (-not $Force) { throw 'repair plan contains a mutating quarantine operation; pass -Force only after reviewing the JSON plan' }
  $receipt = New-DshRepairReceipt -StateRoot $StateRoot -Profile $Profile
  $applied = [System.Collections.Generic.List[object]]::new()
  $skipped = [System.Collections.Generic.List[object]]::new()
  try {
    $seen = @{}
    foreach ($operation in $operations) {
      $kind = [string](Get-DshRepairProperty -Object $operation -Name 'kind')
      if ($kind -ne 'quarantine-plugin') { [void]$skipped.Add($operation); continue }
      $pluginId = [string](Get-DshRepairProperty -Object $operation -Name 'pluginId')
      if ($seen.ContainsKey($pluginId)) { continue }
      $seen[$pluginId] = $true
      [void]$applied.Add((Set-DshRepairPluginQuarantine -PluginId $pluginId -Profile $Profile -DshHome $DshHome -StateRoot $StateRoot))
    }
    $updated = Get-Content -LiteralPath $receipt.path -Raw -Encoding UTF8 | ConvertFrom-Json
    foreach ($file in @($updated.files)) {
      $target = Join-Path $StateRoot ([string](Get-DshRepairProperty -Object $file -Name 'relativePath'))
      $file | Add-Member -NotePropertyName postSha256 -NotePropertyValue (Get-DshRepairHash -Path $target) -Force
    }
    $updated.transaction.status = 'committed'
    $updated.transaction.committedAt = (Get-Date).ToUniversalTime().ToString('o')
    $updated | Add-Member -NotePropertyName applied -NotePropertyValue @($applied) -Force
    $updated | Add-Member -NotePropertyName skipped -NotePropertyValue @($skipped) -Force
    $updated | Add-Member -NotePropertyName changed -NotePropertyValue $true -Force
    Write-DshRepairAtomicText -Path $receipt.path -Text ($updated | ConvertTo-Json -Depth 20)
    $transaction = [ordered]@{
      schemaVersion = 1
      receiptId = [string]$updated.id
      profile = [string]$updated.profile
      stateRoot = [string]$updated.stateRoot
      status = 'committed'
      createdAt = [string]$updated.createdAt
      committedAt = [string]$updated.transaction.committedAt
      safety = 'The guard state and patch were written through bounded local replacement files.'
    }
    Write-DshRepairAtomicText -Path $receipt.transactionPath -Text ($transaction | ConvertTo-Json -Depth 12)
    return [ordered]@{ status = 'applied'; applied = @($applied); skipped = @($skipped); receipt = $receipt.path; changed = $true; restartRequired = $true; safety = 'Only the reversible guard state and generated patch were changed. Restart DSH to load the patch.' }
  } catch {
    try { Restore-DshRepairReceipt -ReceiptPath $receipt.path -Force -SkipConcurrencyCheck | Out-Null } catch { }
    try {
      $failedTransaction = [ordered]@{
        schemaVersion = 1
        receiptId = $receipt.id
        profile = $Profile
        stateRoot = [IO.Path]::GetFullPath($StateRoot)
        status = 'rolled-back-or-manual-review'
        createdAt = (Get-Date).ToUniversalTime().ToString('o')
        committedAt = $null
      }
      Write-DshRepairAtomicText -Path $receipt.transactionPath -Text ($failedTransaction | ConvertTo-Json -Depth 12)
    } catch { }
    throw
  }
}

function Restore-DshRepairReceipt {
  param(
    [Parameter(Mandatory = $true)][string]$ReceiptPath,
    [switch]$Force,
    [switch]$SkipConcurrencyCheck
  )
  if (-not $Force) { throw 'reverting a repair receipt changes guard state; pass -Force after reviewing the receipt' }
  $resolvedReceipt = [IO.Path]::GetFullPath($ReceiptPath)
  if (-not (Test-Path -LiteralPath $resolvedReceipt -PathType Leaf)) { throw "repair receipt does not exist: $ReceiptPath" }
  if ([IO.Path]::GetFileName($resolvedReceipt) -cne 'manifest.json') { throw 'repair receipt must be a manifest.json generated by this tool' }
  $manifest = Get-Content -LiteralPath $resolvedReceipt -Raw -Encoding UTF8 | ConvertFrom-Json
  if ([int](Get-DshRepairProperty -Object $manifest -Name 'schemaVersion') -ne 2) { throw 'unsupported repair receipt schema' }
  if ([string](Get-DshRepairProperty -Object (Get-DshRepairProperty -Object $manifest -Name 'transaction') -Name 'status') -ne 'committed' -and -not $SkipConcurrencyCheck) {
    throw 'repair receipt is not committed; manual review is required'
  }
  $recordedStateRoot = [string](Get-DshRepairProperty -Object $manifest -Name 'stateRoot')
  if ([string]::IsNullOrWhiteSpace($recordedStateRoot)) { throw 'repair receipt does not record a StateRoot' }
  $stateRoot = [IO.Path]::GetFullPath($recordedStateRoot)
  $repairRoot = Join-Path $stateRoot 'repair'
  if (-not (Test-DshRepairPathWithin -BasePath $repairRoot -CandidatePath $resolvedReceipt)) { throw 'repair receipt is outside its recorded StateRoot repair directory' }
  $receiptRoot = Split-Path -Parent $resolvedReceipt
  $preimageRoot = Join-Path $receiptRoot 'preimage'
  if (-not (Test-DshRepairPathWithin -BasePath $receiptRoot -CandidatePath $preimageRoot)) { throw 'repair receipt preimage root escaped its receipt directory' }
  $manifestFiles = @(Get-DshRepairProperty -Object $manifest -Name 'files')
  if ($manifestFiles.Count -ne 2) { throw 'repair receipt must contain exactly two guard-file entries' }
  $seenRelativePaths = @{}
  $allowedRelativePaths = @('guard-state.json', 'guard.patch.yml')
  foreach ($file in $manifestFiles) {
    $relativePath = [string](Get-DshRepairProperty -Object $file -Name 'relativePath')
    if ($relativePath -notin $allowedRelativePaths) { throw "receipt contains a forbidden path: $relativePath" }
    if ($seenRelativePaths.ContainsKey($relativePath)) { throw "repair receipt contains duplicate file entry: $relativePath" }
    $seenRelativePaths[$relativePath] = $true
    $existedValue = Get-DshRepairProperty -Object $file -Name 'existed'
    if ($existedValue -isnot [bool]) { throw "repair receipt existed flag is invalid: $relativePath" }
    $preimageHash = [string](Get-DshRepairProperty -Object $file -Name 'sha256')
    if ([bool]$existedValue) {
      if (-not (Test-DshRepairSha256 -Hash $preimageHash)) { throw "repair receipt pre-image hash is invalid: $relativePath" }
    } elseif ($null -ne (Get-DshRepairProperty -Object $file -Name 'sha256') -and -not [string]::IsNullOrWhiteSpace($preimageHash)) {
      throw "repair receipt records a pre-image for a generated file: $relativePath"
    }
    if (-not $SkipConcurrencyCheck) {
      $postHash = [string](Get-DshRepairProperty -Object $file -Name 'postSha256')
      if (-not (Test-DshRepairSha256 -Hash $postHash)) { throw "ROLLBACK_CONFLICT: receipt is missing a valid post-image hash for $relativePath" }
    }
  }
  foreach ($requiredPath in $allowedRelativePaths) {
    if (-not $seenRelativePaths.ContainsKey($requiredPath)) { throw "repair receipt is missing guard-file entry: $requiredPath" }
  }
  $restored = [System.Collections.Generic.List[object]]::new()
  if (-not $SkipConcurrencyCheck) {
    foreach ($file in $manifestFiles) {
      $relativePath = [string](Get-DshRepairProperty -Object $file -Name 'relativePath')
      $target = Join-Path $stateRoot $relativePath
      $expectedPostHash = [string](Get-DshRepairProperty -Object $file -Name 'postSha256')
      $currentHash = [string](Get-DshRepairHash -Path $target)
      if ($currentHash -cne $expectedPostHash) {
        throw "ROLLBACK_CONFLICT: $relativePath changed after repair; expected post-image $expectedPostHash but observed $currentHash"
      }
    }
  }
  foreach ($file in $manifestFiles) {
    $relativePath = [string](Get-DshRepairProperty -Object $file -Name 'relativePath')
    $target = Join-Path $stateRoot $relativePath
    $existed = [bool](Get-DshRepairProperty -Object $file -Name 'existed')
    if ($existed) {
      $source = Join-Path $preimageRoot $relativePath
      if (-not (Test-Path -LiteralPath $source -PathType Leaf)) { throw "receipt preimage is missing: $relativePath" }
      if (-not (Test-DshRepairPathWithin -BasePath $preimageRoot -CandidatePath $source)) { throw 'receipt preimage escaped its root' }
      $expectedPreimageHash = [string](Get-DshRepairProperty -Object $file -Name 'sha256')
      $actualPreimageHash = [string](Get-DshRepairHash -Path $source)
      if ($actualPreimageHash -cne $expectedPreimageHash) { throw "repair receipt pre-image changed: $relativePath" }
      $parent = Split-Path -Parent $target
      if (-not (Test-Path -LiteralPath $parent -PathType Container)) { New-Item -ItemType Directory -Path $parent -Force | Out-Null }
      Copy-Item -LiteralPath $source -Destination $target -Force
      $action = 'restored'
    } else {
      if (Test-Path -LiteralPath $target -PathType Leaf) { Remove-Item -LiteralPath $target -Force }
      $action = 'removed-generated-file'
    }
    [void]$restored.Add([ordered]@{ relativePath = $relativePath; action = $action; sha256 = Get-DshRepairHash -Path $target })
  }
  return [ordered]@{ status = 'reverted'; receipt = $resolvedReceipt; restored = @($restored); changed = $true; safety = 'Only the two guard files captured by this receipt were restored or removed.' }
}

function New-DshRepairPrompt {
  param(
    [Parameter(Mandatory = $true)]$Diagnostics,
    [Parameter(Mandatory = $true)][string]$Profile
  )
  $safeJson = $Diagnostics | ConvertTo-Json -Depth 20 -Compress
  $safeJson = Protect-DshRepairText -Value $safeJson -MaxLength 14000
  $binding = Get-DshRepairEvidenceBinding -Diagnostics $Diagnostics
  $expiresAt = (Get-Date).ToUniversalTime().AddMinutes(15).ToString('o')
  $candidateJson = ConvertTo-Json -InputObject @($binding.observedCandidateIds) -Compress
  if ([string]::IsNullOrWhiteSpace([string]$candidateJson)) { $candidateJson = '[]' }
  return @"
You are the read-only recovery planner inside DeepSeek Harness.
Analyze the following already-sanitized diagnostics. Do not call tools. Do not read or write files. Do not invent a model, plugin, path, permission approval, or causal conclusion.
Return ONLY one JSON object with this shape:
{"schemaVersion":2,"incidentId":"$($binding.incidentId)","evidenceHash":"$($binding.evidenceHash)","observedCandidateIds":$candidateJson,"expiresAt":"$expiresAt","profile":"$Profile","mode":"advisory","operations":[...]}
Allowed operations are only:
{"kind":"quarantine-plugin","pluginId":"third-party-plugin-id","candidateId":"same-as-plugin-id","evidence":"...","confidence":"observed|review","requiresApproval":true,"rationale":"..."}
{"kind":"restart-profile","profile":"$Profile","requiresApproval":true,"mutates":false,"rationale":"..."}
{"kind":"recommendation","recommendationCode":"...","message":"...","mutates":false}
Never include command, commands, script, shell, args, arguments, path, url, cwd, expression, eval, code, or tool parameters. If evidence is insufficient, return an empty operations array.
The plan must use the exact incidentId, evidenceHash, observedCandidateIds, expiresAt, and profile values supplied above. It must not invent a plugin id.
Diagnostics:
$safeJson
"@
}

function Get-DshRepairTextFromValue {
  param([AllowNull()]$Value)
  if ($null -eq $Value) { return '' }
  if ($Value -is [string]) { return [string]$Value }
  $type = [string](Get-DshRepairProperty -Object $Value -Name 'type')
  $text = Get-DshRepairProperty -Object $Value -Name 'text'
  if (-not [string]::IsNullOrWhiteSpace([string]$text)) { return [string]$text }
  if ($type -eq 'text') {
    $nested = Get-DshRepairProperty -Object $Value -Name 'content'
    if ($null -ne $nested) { return Get-DshRepairTextFromValue -Value $nested }
  }
  if ($Value -is [System.Collections.IEnumerable] -and $Value -isnot [string]) {
    $parts = [System.Collections.Generic.List[string]]::new()
    foreach ($item in $Value) {
      $part = Get-DshRepairTextFromValue -Value $item
      if (-not [string]::IsNullOrWhiteSpace($part)) { [void]$parts.Add($part) }
    }
    return ($parts -join '')
  }
  return ''
}

function ConvertFrom-DshRepairModelText {
  param([Parameter(Mandatory = $true)][string]$Text)
  $bounded = Protect-DshRepairText -Value $Text -MaxLength 64000
  $candidate = $bounded.Trim()
  $fence = [regex]::Match($candidate, '(?s)```(?:json)?\s*(\{.*?\})\s*```')
  if ($fence.Success) { $candidate = $fence.Groups[1].Value }
  else {
    $start = $candidate.IndexOf('{')
    $end = $candidate.LastIndexOf('}')
    if ($start -ge 0 -and $end -gt $start) { $candidate = $candidate.Substring($start, $end - $start + 1) }
  }
  try { return $candidate | ConvertFrom-Json } catch { throw "model repair response is not valid JSON: $($_.Exception.Message)" }
}

function Test-DshRepairHostNoToolsCapability {
  param([AllowNull()]$HostDescription)
  if ($null -eq $HostDescription) { return $false }
  $capabilities = Get-DshRepairProperty -Object $HostDescription -Name 'capabilities'
  $flags = @(
    (Get-DshRepairProperty -Object $HostDescription -Name 'noToolsSession'),
    (Get-DshRepairProperty -Object $HostDescription -Name 'restrictedPlannerNoTools'),
    (Get-DshRepairProperty -Object $capabilities -Name 'noToolsSession'),
    (Get-DshRepairProperty -Object $capabilities -Name 'restrictedPlannerNoTools'),
    (Get-DshRepairProperty -Object $capabilities -Name 'toolsDisabledForPlanner')
  )
  if (@($flags | Where-Object { $_ -eq $true }).Count -gt 0) { return $true }
  $toolAccess = [string](Get-DshRepairProperty -Object $capabilities -Name 'toolAccess')
  return $toolAccess.ToLowerInvariant() -in @('none', 'disabled')
}

function Test-DshRepairExecutionEvent {
  param([AllowNull()][string]$Type)
  if ([string]::IsNullOrWhiteSpace($Type)) { return $false }
  return $Type -match '^(?i:tool/|approval/|execution/|command/|shell/)' -or
    $Type -in @('approval-required', 'permission/request', 'tool-call', 'tool-execution')
}

function Invoke-DshModelRepairAssist {
  param(
    [Parameter(Mandatory = $true)][string]$BaseUrl,
    [Parameter(Mandatory = $true)]$Diagnostics,
    [string]$Profile = 'debug',
    [string]$SessionId = '',
    [string]$Cwd = '',
    [int]$TimeoutSec = 60
  )
  if ($TimeoutSec -lt 5 -or $TimeoutSec -gt 300) { throw 'TimeoutSec must be between 5 and 300' }
  if (-not [string]::IsNullOrWhiteSpace($SessionId)) {
    return [ordered]@{
      status = 'unavailable'
      sessionId = $null
      sessionCreated = $false
      toolCallsObserved = 0
      executionEventsObserved = 0
      modelResponseStored = $false
      plan = $null
      cwdForwarded = $false
      reason = 'An existing user Session is never accepted for automatic repair planning; an isolated planner Session is required.'
    }
  }
  $hostValue = $null
  try {
    $hostValue = Invoke-DshGuardApi -BaseUrl $BaseUrl -Method 'host.describe' -Arguments @{} -TimeoutSec 4
  } catch {
    return [ordered]@{
      status = 'unavailable'
      sessionId = $null
      sessionCreated = $false
      toolCallsObserved = 0
      executionEventsObserved = 0
      modelResponseStored = $false
      plan = $null
      cwdForwarded = $false
      reason = 'host.describe was unavailable; the repair planner requires an explicit Host-side no-tools capability.'
    }
  }
  if (-not (Test-DshRepairHostNoToolsCapability -HostDescription $hostValue)) {
    return [ordered]@{
      status = 'unavailable'
      sessionId = $null
      sessionCreated = $false
      toolCallsObserved = 0
      executionEventsObserved = 0
      modelResponseStored = $false
      plan = $null
      cwdForwarded = $false
      reason = 'The current DSH Host did not explicitly advertise a no-tools planner Session; refusing to create a normal model Session.'
    }
  }
  $created = $false
  $createdValue = Invoke-DshGuardApi -BaseUrl $BaseUrl -Method 'session.create' -Arguments @{ agentPreset = 'minimal' } -TimeoutSec 8
  $SessionId = [string]$createdValue.sessionId
  if ([string]::IsNullOrWhiteSpace($SessionId)) { throw 'session.create returned no session id' }
  $created = $true
  $prompt = New-DshRepairPrompt -Diagnostics $Diagnostics -Profile $Profile
  Invoke-DshGuardApi -BaseUrl $BaseUrl -Method 'session.prompt' -Arguments @{
    sessionId = $SessionId
    mode = 'queue'
    content = @(@{ type = 'text'; text = $prompt })
  } -TimeoutSec 8 | Out-Null

  $deadline = (Get-Date).ToUniversalTime().AddSeconds($TimeoutSec)
  $seenSeq = [System.Collections.Generic.HashSet[string]]::new()
  $assistantText = ''
  $toolCalls = 0
  $executionEvents = 0
  $turnEnded = $false
  do {
    $history = Invoke-DshGuardApi -BaseUrl $BaseUrl -Method 'session.history' -Arguments @{ sessionId = $SessionId; maxMessages = 120 } -TimeoutSec 8
    foreach ($entry in @($history.events)) {
      $event = Get-DshRepairProperty -Object $entry -Name 'event'
      if ($null -eq $event) { continue }
      $seq = [string](Get-DshRepairProperty -Object $event -Name 'seq')
      if (-not $seenSeq.Add($seq)) { continue }
      $type = [string](Get-DshRepairProperty -Object $event -Name 'type')
      $data = Get-DshRepairProperty -Object $event -Name 'data'
      if (Test-DshRepairExecutionEvent -Type $type) {
        $executionEvents += 1
        if ($type -eq 'tool/call') { $toolCalls += 1 }
        return [ordered]@{
          status = 'rejected'
          sessionId = $SessionId
          sessionCreated = $created
          toolCallsObserved = $toolCalls
          executionEventsObserved = $executionEvents
          modelResponseStored = $false
          plan = $null
          cwdForwarded = $false
          reason = "The planner Session emitted an execution-related event '$type'; the proposal was discarded."
        }
      }
      if ($type -in @('assistant/message', 'assistant/chunk', 'assistant')) {
        foreach ($candidate in @(
            (Get-DshRepairProperty -Object $data -Name 'message'),
            (Get-DshRepairProperty -Object $data -Name 'content'),
            (Get-DshRepairProperty -Object $data -Name 'text'),
            (Get-DshRepairProperty -Object $data -Name 'delta')
          )) {
          $part = Get-DshRepairTextFromValue -Value $candidate
          if (-not [string]::IsNullOrWhiteSpace($part)) {
            if ($type -eq 'assistant/message') { $assistantText = $part } else { $assistantText += $part }
            break
          }
        }
      }
      if ($type -eq 'turn/end') { $turnEnded = $true }
    }
    if ($toolCalls -gt 0) { break }
    if (-not [string]::IsNullOrWhiteSpace($assistantText)) {
      try {
        $candidatePlan = ConvertFrom-DshRepairModelText -Text $assistantText
        $planCheck = Test-DshRepairPlan -Plan $candidatePlan
        if ($planCheck.valid) {
          return [ordered]@{ status = 'plan-ready'; sessionId = $SessionId; sessionCreated = $created; toolCallsObserved = $toolCalls; executionEventsObserved = $executionEvents; modelResponseStored = $false; plan = $candidatePlan; preview = Protect-DshRepairText -Value $assistantText -MaxLength 600; cwdForwarded = $false; safety = 'The model only suggested a validated allowlist plan. No operation was applied.' }
        }
      } catch { }
    }
    if ($turnEnded -and -not [string]::IsNullOrWhiteSpace($assistantText)) { break }
    if ((Get-Date).ToUniversalTime() -ge $deadline) { break }
    Start-Sleep -Milliseconds 500
  } while ((Get-Date).ToUniversalTime() -lt $deadline)

  if ($toolCalls -gt 0) {
    return [ordered]@{ status = 'rejected'; sessionId = $SessionId; sessionCreated = $created; toolCallsObserved = $toolCalls; executionEventsObserved = $executionEvents; modelResponseStored = $false; plan = $null; cwdForwarded = $false; reason = 'The model session emitted an execution event; the repair assistant refuses to consume or apply that response.' }
  }
  return [ordered]@{ status = 'unavailable'; sessionId = $SessionId; sessionCreated = $created; toolCallsObserved = $toolCalls; executionEventsObserved = $executionEvents; modelResponseStored = $false; plan = $null; cwdForwarded = $false; reason = if ($turnEnded) { 'The model turn ended without a valid allowlist JSON plan.' } else { 'The model did not return a valid plan before the bounded timeout.' } }
}

