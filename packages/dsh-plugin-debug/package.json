{
  "name": "dsh-plugin-debug",
  "version": "0.8.3",
  "description": "A single DeepSeek Harness debug plugin for diagnostics, recovery, trace inspection, and observer-only task protection",
  "author": "shine-233",
  "repository": {
    "type": "git",
    "url": "https://github.com/shine-233/dsh-plugin-debug.git",
    "directory": "packages/dsh-plugin-debug"
  },
  "bugs": {
    "url": "https://github.com/shine-233/dsh-plugin-debug/issues"
  },
  "homepage": "https://github.com/shine-233/dsh-plugin-debug#readme",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./repository-check": {
      "default": "./lib/repository-check.js"
    },
    "./hotswap-check": {
      "default": "./lib/hotswap-check.js"
    },
    "./agent-report": {
      "default": "./lib/agent-report.js"
    },
    "./guardian": {
      "default": "./lib/task-guardian.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "sbom",
    "bundle-manifest.json",
    "cordis.patch.yml",
    "tool-policy.patch.example.yml",
    "tools",
    "!tools/runtime/node_modules",
    "!tools/runtime/node_modules/**",
    "Start-DSH-Debug.ps1",
    "Start-DSH-Debug.cmd",
    "Start-DSH-Debug.vbs",
    "Start-DSH-Combined.ps1",
    "Start-DSH-Combined.cmd",
    "Start-DSH-Combined.vbs",
    "DEBUG-QUICKSTART.md",
    "Debug-DSH.ps1",
    "DSH-Provenance.ps1",
    "DSH-Debug.ps1",
    "DSH-Debug.cmd",
    "DSH-Debug.vbs",
    "Test-DSHStandalone.ps1",
    "RESEARCH.md",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:client": "node scripts/build-client.mjs",
    "prepack": "npm run build",
    "test": "node --test",
    "check": "node scripts/build.mjs && node scripts/check-generated.mjs && node scripts/check-syntax.mjs && node --test",
    "lint": "node scripts/check-quality.mjs",
    "format:check": "node scripts/check-format.mjs",
    "typecheck": "node scripts/check-type-surface.mjs",
    "coverage": "node --test --experimental-test-coverage",
    "check:runtime-lock": "node scripts/check-runtime-lock.mjs",
    "check:runtime-lock:installed": "node scripts/check-runtime-lock.mjs --installed",
    "sbom:generate": "node scripts/generate-sbom.mjs",
    "sbom:check": "node scripts/generate-sbom.mjs --check",
    "check:standalone": "pwsh -NoLogo -NoProfile -ExecutionPolicy Bypass -File .\\Test-DSHStandalone.ps1",
    "check:integration": "pwsh -NoLogo -NoProfile -ExecutionPolicy Bypass -File .\\tools\\Test-DSHPluginIntegration.ps1"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "provenance",
    "debug",
    "health-check",
    "crash-guard",
    "plugin-inspector",
    "diagnostics-diff",
    "plugin-preflight",
    "dependency-graph",
    "trace-loop",
    "trace-recursion",
    "task-guardian",
    "safe-restart"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.6 <0.2.0",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-tools": "0.1.0-rc.6"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "directories": {
    "lib": "lib",
    "test": "tests"
  }
}
